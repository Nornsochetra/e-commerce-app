# Active local profile.
SPRING_PROFILES_ACTIVE=dev
# Local PostgreSQL connection URL.
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce_dev
# Local PostgreSQL username.
DATABASE_USERNAME=postgres
# Local PostgreSQL password.
DATABASE_PASSWORD=postgres
# Optional public-key resource location; blank generates ephemeral dev keys.
RSA_PUBLIC_KEY=
# Optional private-key resource location; blank generates ephemeral dev keys.
RSA_PRIVATE_KEY=
# Directory for local access logs.
LOG_DIR=./logs
# Comma-separated frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
